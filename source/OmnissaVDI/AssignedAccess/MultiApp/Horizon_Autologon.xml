<?xml version="1.0" encoding="utf-8"?>
<!--
  Multi-App Kiosk + AutoLogon for the Omnissa Horizon Client.
  - AutoLogon as KioskUser0 (passwordless, created implicitly by <AutoLogonAccount>)
  - Taskbar shown so the user can reach the Wi-Fi flyout (mobile devices switch networks)
  - horizon-client.exe is auto-launched via a Startup-folder shortcut placed by the config script
  - The Settings UWP is whitelisted so the network flyout / Wi-Fi page is reachable

  Placeholders replaced by Set-OmnissaVDIKioskSettings.ps1 at install time:
    {{HORIZON_DIR}}          install directory of the Horizon Client (contains horizon-client.exe)
    {{HORIZON_EXTRA_APPS}}   optional additional <App DesktopAppPath="..."/> lines (helper EXEs)
    {{HORIZON_LNK}}          full path to the Omnissa Horizon Client.lnk in the ProgramData Start Menu
-->
<AssignedAccessConfiguration xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns="http://schemas.microsoft.com/AssignedAccess/2017/config" xmlns:default="http://schemas.microsoft.com/AssignedAccess/2017/config" xmlns:rs5="http://schemas.microsoft.com/AssignedAccess/201810/config" xmlns:v3="http://schemas.microsoft.com/AssignedAccess/2020/config" xmlns:v5="http://schemas.microsoft.com/AssignedAccess/2022/config">
  <Profiles>
    <Profile Id="{9A2A490F-10F6-4764-974A-43B19E722C23}">
      <AllAppsList>
        <AllowedApps>
          <App DesktopAppPath="{{HORIZON_DIR}}\horizon-client.exe" />
          <App DesktopAppPath="{{HORIZON_DIR}}\horizon-protocol.exe" />
          <App DesktopAppPath="{{HORIZON_DIR}}\horizon-usbdloader.exe" />
          <App DesktopAppPath="{{HORIZON_DIR}}\horizon-appstub.exe" />
          <App DesktopAppPath="%windir%\System32\WindowsPowerShell\v1.0\powershell.exe" />
          <!-- Zscaler Client Connector (user-session processes only; ZSATrayManager / ZSAService /
               ZSATunnel run as SYSTEM and need no entry). ZSATray = the UI the user operates;
               ZSAUpm = the per-user agent. The MS365 (SAML) SSO window is hosted in Edge WebView2,
               which installs into a version-numbered folder. The '*' makes the generated AppLocker
               path rule match ANY WebView2 version, so it survives WebView2 auto-updates without a
               redeploy (the name-based RestrictRun rule for msedgewebview2.exe is version-independent
               too). Requires "WebView2 Authentication" enabled in the Zscaler portal. Verify the
               Zscaler paths on the device: Get-ChildItem "C:\Program Files\Zscaler" -Recurse -Filter *.exe -->
          <App DesktopAppPath="C:\Program Files\Zscaler\ZSATray\ZSATray.exe" />
          <App DesktopAppPath="C:\Program Files\Zscaler\ZSAUpm\ZSAUpm.exe" />
          <App DesktopAppPath="%ProgramFiles(x86)%\Microsoft\EdgeWebView\Application\*\msedgewebview2.exe" />
          <!-- ISL Light remote support client (also pinned to Start + taskbar below). Path comes from the config script. -->
          <App DesktopAppPath="{{ISL_PATH}}" />
{{HORIZON_EXTRA_APPS}}
          <App AppUserModelId="windows.immersivecontrolpanel_cw5n1h2txyewy!microsoft.windows.immersivecontrolpanel" />
        </AllowedApps>
      </AllAppsList>
      <v5:StartPins>
        <![CDATA[{
          "pinnedList":[
            {"desktopAppLink":"{{HORIZON_LNK}}"},
            {"desktopAppLink":"%ALLUSERSPROFILE%\\Microsoft\\Windows\\Start Menu\\Programs\\Zscaler\\Zscaler.lnk"},
            {"desktopAppLink":"%ALLUSERSPROFILE%\\Microsoft\\Windows\\Start Menu\\Programs\\ISL Light Client.lnk"}
          ]
        }]]>
      </v5:StartPins>
      <Taskbar ShowTaskbar="true"/>
      <!-- Pin only the Omnissa Horizon Client to the taskbar (Replace removes the default Edge/Store/etc. pins). -->
      <v5:TaskbarLayout>
        <![CDATA[
<LayoutModificationTemplate xmlns="http://schemas.microsoft.com/Start/2014/LayoutModification" xmlns:defaultlayout="http://schemas.microsoft.com/Start/2014/FullDefaultLayout" xmlns:start="http://schemas.microsoft.com/Start/2014/StartLayout" xmlns:taskbar="http://schemas.microsoft.com/Start/2014/TaskbarLayout" Version="1">
  <CustomTaskbarLayoutCollection PinListPlacement="Replace">
    <defaultlayout:TaskbarLayout>
      <taskbar:TaskbarPinList>
        <taskbar:DesktopApp DesktopApplicationLinkPath="%ALLUSERSPROFILE%\Microsoft\Windows\Start Menu\Programs\Omnissa Horizon Client.lnk" />
        <taskbar:DesktopApp DesktopApplicationLinkPath="%ALLUSERSPROFILE%\Microsoft\Windows\Start Menu\Programs\Zscaler\Zscaler.lnk" />
        <taskbar:DesktopApp DesktopApplicationLinkPath="%ALLUSERSPROFILE%\Microsoft\Windows\Start Menu\Programs\ISL Light Client.lnk" />
      </taskbar:TaskbarPinList>
    </defaultlayout:TaskbarLayout>
  </CustomTaskbarLayoutCollection>
</LayoutModificationTemplate>
        ]]>
      </v5:TaskbarLayout>
    </Profile>
  </Profiles>
  <Configs>
    <Config>
      <AutoLogonAccount rs5:DisplayName="Kiosk User"/>
      <DefaultProfile Id="{9A2A490F-10F6-4764-974A-43B19E722C23}"/>
    </Config>
  </Configs>
</AssignedAccessConfiguration>
